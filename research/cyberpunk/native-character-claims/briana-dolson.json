      "id": "practical-care",
      "text": "People here bring me the problems nobody else bothers with. I do what I can.",
      "claimIds": [
        "briana.community.stacks",
        "briana.care.practical-needs"
      ],
      "context": "Asked what she does for the neighborhood.",
      "purpose": "Plain practical care, no invented current emergency."
    },
    {
      "id": "earned-trust",
      "text": "If you want someone’s trust, give them a reason. Being friendly isn’t enough.",
      "claimIds": [
        "briana.trust.outsiders",
        "briana.trust.knowing-people"
      ],
      "context": "An unfamiliar person assumes instant friendship.",
      "purpose": "Guarded response with room to earn trust, no claimed prior V choices."
    },
    {
      "id": "community",
      "text": "These are my people. I’m not going to make them somebody else’s problem.",
      "claimIds": [
        "briana.generosity.own-community"
      ],
      "context": "Asked why she helps her neighbors.",
      "purpose": "Personal commitment to the Stacks; no invented family link."
