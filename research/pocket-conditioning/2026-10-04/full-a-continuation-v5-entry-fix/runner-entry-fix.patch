+def honest_primary_metadata(rows: list[dict[str, Any]], *, native_admission: bool) -> bool:
+    """Native admission proves missing derived flags through actual history fences."""
+    for row in rows:
+        if native_admission:
+            if row.get("validation_tier") not in (None, "A_unseen_scene"):
+                return False
+            if any(row.get(key) is not None and row.get(key) is not False
+                   for key in ("previous_training_seen", "previous_training_scene_seen")):
+                return False
+        elif (row.get("validation_tier") != "A_unseen_scene"
+              or row.get("previous_training_seen") is not False
+              or row.get("previous_training_scene_seen") is not False):
+            return False
+    return True
 
 
