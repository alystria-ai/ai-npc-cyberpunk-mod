+def _sha(value):
+    if not isinstance(value, str) or re.fullmatch(r"[0-9a-f]{64}", value) is None:
+        fail("an evidence descriptor lacks a full SHA256")
+    return value
+
+
+def _pairs(items):
+    value = {}
+    for key, item in items:
+        if key in value:
+            fail("duplicate JSON key: " + key)
+        value[key] = item
+    return value
+
