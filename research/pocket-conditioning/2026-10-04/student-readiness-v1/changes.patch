+def load_selected_weights(spec: Spec, model: Any, checkpoint: Path, *, flow_only: bool = False) -> dict:
+    """Selected evaluation starts from architecture, then admits one exact ABI."""
+    import torch
+    from pocket_tts.modules.voice_identity import assert_weight_abi
+    payload = torch.load(checkpoint, map_location="cpu", weights_only=True)
+    if payload.get("runner", {}).get("input_identity") != spec.identity:
+        raise ValueError("Selected checkpoint does not belong to these exact inputs")
+    conditioning.verify_checkpoint(spec, payload)
+    receipt = assert_weight_abi(model.flow_lm, checkpoint, use_ema=bool(payload.get("ema")), checkpoint_payload=payload)
+    state = {**payload["model"], **(payload.get("ema") or {})}
+    if flow_only:
+        model.flow_lm.load_state_dict({k.removeprefix("flow_lm."): v for k, v in state.items()
+                                      if k.startswith("flow_lm.")}, strict=True)
+    else:
+        model.load_state_dict(state, strict=True)
+    bank = getattr(model.flow_lm, "voice_identity", None)
+    if bank is not None and bank.table_hash() != receipt["table_sha256"]:
+        raise ValueError("Selected evaluation loaded another identity table")
+    return {"step": int(payload["step"]),
+            "weights": payload.get("runner", {}).get("selection_weights", "ema"),
+            "validated_probe_count": payload.get("runner", {}).get("validated_probe_count", 0)}
+
