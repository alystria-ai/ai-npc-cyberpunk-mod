# Voice cloning devslot now lives outside the repo (Downloads).
convai voice cloning devslot/
# Game audio extracted for an add-on's voice reference stays on the developer's machine (the Delamain and Skippy add-ons keep the same rule in their own repositories).
/addons/*/voice/*.wav
/addons/*/voice/*-reference.json
# The root TODO.md is the maintained work list and captain's log.
!/TODO.md

# Add-on voice references are cut from the game audio: kept out of git, packed from the local copy by build-addon.mjs.
/addons/*/voice/*.wav
/addons/*/voice/*.voice.json

# V's voice for typed lines (docs/V_VOICE.md): the reference clips are cut from the game audio and stay on the developer's machine; the
# manifest assets/v-voice/v-voice.json (transcripts and hashes) is committed. packaging/build-release.mjs packs the clips from the local copy.
/assets/v-voice/*.wav
/assets/v-voice/v-voice-build.json

# Files made for the developer (samples, reports, the install tutorial): kept in the project folder, never committed.
/deliverables/

# The error reports' backend address and signing secret a release build writes into the Runtime (bridge/error-reports.mjs): never committed.
/defaults/error-reports.json
