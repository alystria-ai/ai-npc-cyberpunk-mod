+def publish_saved_training(spec: Spec, stage: str, step: int, checkpoint: Path,
+                           runner_state: dict[str, Any]) -> None:
+    """Publish the immutable checkpoint while every training rank is stopped."""
+    if not spec.option("private_remote_checkpoints", False) or step < 1:
+        return
+    if stage != "teacher":
+        raise ValueError("Private remote publication is restricted to the full A teacher")
+    checkpoint_sha = sha256_file(checkpoint)
+    stage_dir = spec.output / stage
+    exports: dict[str, Path] = {}
+    sidecars = [stage_dir / name for name in (
+        "quality-anchor.json", "candidate-index.json", "evaluation-completed.json",
+        "heldout.json", "best.json", "metrics.json", "precision.json", "state.json", "args.yaml")]
+    index = read_json(stage_dir / "candidate-index.json", {})
+    if index:
+        if index.get("input_identity") != spec.identity:
+            raise ValueError("Retained candidate index belongs to another training run")
+        for row in index.get("candidates", []):
+            candidate = (spec.output / row["path"]).resolve(strict=True)
+            if not candidate.is_relative_to((stage_dir / "candidates").resolve()):
+                raise ValueError("Retained candidate path escaped the training stage")
+            if sha256_file(candidate) != row["sha256"]:
+                raise ValueError("Retained compact candidate changed before private publication")
+            exports[row["path"]] = candidate
+    ticket = runner_state.get("pending_evaluation")
+    if isinstance(ticket, dict) and ticket.get("step") == step:
+        for kind in ("ema", "raw"):
+            quality = stage_dir / f"quality-step{step:09d}-{kind}.json"
+            if quality.is_file() and read_json(quality, {}).get("evaluation_ticket") == ticket:
+                sidecars.append(quality)
+                folder = spec.output / f"comparisons/teacher-rollout-step{step:06d}-{kind}"
+                sidecars.extend(p for p in (folder / "metrics.json", folder / "samples.json") if p.is_file())
+                for row in read_json(folder / "samples.json", []):
+                    if row.get("audio"):
+                        audio = (folder / row["audio"]).resolve(strict=True)
+                        if not audio.is_relative_to(folder.resolve()):
+                            raise ValueError("Speech evidence escaped its evaluation folder")
+                        exports[audio.relative_to(spec.output).as_posix()] = audio
+    existing_sidecars = [path for path in sidecars if path.is_file()]
+    identities = {path.relative_to(spec.output).as_posix(): sha256_file(path)
+                  for path in existing_sidecars}
+    identities.update({name: sha256_file(path) for name, path in exports.items()})
+    identity_data = json.dumps({"checkpoint": checkpoint_sha, "exports": identities}, sort_keys=True)
+    snapshot_sha = hashlib.sha256(identity_data.encode("utf-8")).hexdigest()
+    # Pending evaluation and completed evaluation may save different states at
+    # the same optimizer step. Each frozen snapshot gets a unique remote path.
+    run_id = f"{spec.raw['remote_checkpoint_run_id']}-{snapshot_sha[:12]}"
+    snapshot_dir = stage_dir / "remote-state" / "snapshots" / f"{run_id}-step-{step:06d}"
+    for path in existing_sidecars:
+        name = path.relative_to(spec.output).as_posix()
+        frozen = snapshot_dir / name
+        if frozen.is_file():
+            if sha256_file(frozen) != identities[name]:
+                raise ValueError("Frozen checkpoint sidecar changed")
+        else:
+            frozen.parent.mkdir(parents=True, exist_ok=True)
+            temporary = frozen.with_name(f".{frozen.name}.{os.getpid()}.tmp")
+            shutil.copyfile(path, temporary)
+            os.replace(temporary, frozen)
+            if sha256_file(frozen) != identities[name]:
+                raise ValueError("Checkpoint sidecar changed during snapshot")
+        exports[name] = frozen
+    exports_json = snapshot_dir / "exports.json"
+    atomic_json(exports_json, {name: str(path) for name, path in sorted(exports.items())})
+    command = [sys.executable, str(Path(__file__).with_name("remote_checkpoints.py")),
+               "--checkpoint", str(checkpoint), "--step", str(step),
+               "--input-identity", spec.identity, "--run-id", run_id,
+               "--state-dir", str(stage_dir / "remote-state"),
+               "--exports-json", str(exports_json)]
+    print(json.dumps({"event": "private_checkpoint_upload_start", "stage": stage,
+                      "step": step, "run_id": run_id, "export_files": len(exports)}), flush=True)
+    completed = subprocess.run(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
+                               text=True, check=False)
+    if completed.returncode:
+        print(json.dumps({"event": "private_checkpoint_upload_failed", "stage": stage,
+                          "step": step, "returncode": completed.returncode}), flush=True)
+        raise RuntimeError("Private checkpoint upload or verification failed; the local last.pt is retained")
+    events = []
+    for line in completed.stdout.splitlines():
+        try:
+            events.append(json.loads(line))
+        except json.JSONDecodeError:
+            continue
+    result = next((item for item in reversed(events)
+                   if isinstance(item, dict) and item.get("event") == "remote_checkpoint_available"), None)
+    if (not result or result.get("step") != step or not isinstance(result.get("commit_oid"), str)
+            or result.get("path_in_repo") != f"runs/{run_id}/step-{step:06d}"):
+        raise RuntimeError("Private checkpoint publisher returned no matching verified receipt")
+    receipt = {"schema": "full_a_remote_checkpoint_v1", "step": step,
+               "input_identity": spec.identity, "checkpoint_sha256": checkpoint_sha,
+               "run_id": run_id, "commit_oid": result["commit_oid"],
+               "path_in_repo": result["path_in_repo"], "verified_at": now_iso()}
+    atomic_json(spec.output / stage / "remote-receipts" /
+                f"step-{step:06d}-{checkpoint_sha[:12]}.json", receipt)
+    print(json.dumps({"event": "private_checkpoint_verified", "stage": stage,
+                      "step": step, "commit_oid": result["commit_oid"],
+                      "path_in_repo": result["path_in_repo"]}), flush=True)
