+def held_out_best_candidate(spec: Spec, stage: str) -> Path:
+    """The retained compact candidate with the lowest macro dev score.
+
+    Used for the final export when per-character gates leave no eligible
+    candidate; its receipt still says it is not listening-qualified.
+    """
+    index = read_json(spec.output / stage / "candidate-index.json", {})
+    best = index.get("diagnostic_best")
+    if not best or index.get("input_identity") != spec.identity:
+        return spec.output / stage / "candidates/no-held-out-candidate.pt"
+    path = (spec.output / best["path"]).resolve()
+    if not path.is_relative_to((spec.output / stage / "candidates").resolve()):
+        raise ValueError("Held-out best candidate escaped the owned candidate directory")
+    if not path.is_file() or sha256_file(path) != best["sha256"]:
+        raise ValueError("Held-out best compact candidate changed")
+    return path
+
+
+def student_plateau_local(spec: Spec, step: int, rows: int) -> bool:
+    """Rank-zero decision for STUDENT_PLATEAU_RULE over committed evaluations."""
+    policy = teacher_continuation.settings(spec, "distill")
+    if (not policy["stop_on_plateau"] or step < spec.raw["distill_min_steps"]
+            or step < spec.raw["distill_warmup_steps"]
+            or step * int(spec.option("effective_batch_size", 64)) / rows < policy["minimum_corpus_passes"]):
+        return False
+    index = read_json(spec.output / "distill/candidate-index.json", {})
+    anchor = read_json(spec.output / "distill/quality-anchor.json", {})
+    if index.get("input_identity") != spec.identity or anchor.get("input_identity") != spec.identity:
+        return False
+    by_step: dict[int, float] = {}
+    for row in index["evaluations"]:
+        score = float(row["score"])
+        by_step[row["step"]] = min(by_step.get(row["step"], math.inf), score if math.isfinite(score) else math.inf)
+    if len(by_step) < policy["minimum_speech_evaluations"]:
+        return False
+    best = float(anchor["hybrid"]["dev"]["score"])
+    best = best if math.isfinite(best) else math.inf
+    delta = float(spec.raw["minimum_relative_improvement"])
+    stagnant = 0
+    for evaluated in sorted(by_step):
+        score = by_step[evaluated]
+        if score < best - (max(abs(best) * delta, 1e-8) if math.isfinite(best) else 0):
+            best, stagnant = score, 0
+        else:
+            stagnant += 1
+    return stagnant >= policy["plateau_patience"]
+
+
+def plateau_after_evaluation(spec: Spec, step: int, rows: int, stage: str,
+                             device: Any, rank: int, world: int) -> bool:
+    if stage == "distill" and spec.raw.get("distill_plateau_rule") == STUDENT_PLATEAU_RULE:
+        return bool(teacher_continuation._rank_zero_result(
+            lambda: student_plateau_local(spec, step, rows), device, rank, world))
+    return teacher_continuation.plateau_reached(spec, step, rows, stage, device, rank, world)
+
